{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forex-executor",
  "compatibility_date": "2026-08-31",
  "main": "./worker/index.js",
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}