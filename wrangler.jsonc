{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forex-executor",
  "compatibility_date": "2026-08-31",
  "main": "./worker/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forex-executor-db",
      "database_id": "7651800a-dd0b-47c6-aece-bcbf5a6e9418"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}